# -----------------------------------------------------------------------------
# Bolzoo environment variables — sample. `cp .env.example .env` дараа өөрийн
# утгуудаа бөглөнө. Жинхэнэ `.env` файл `.gitignore`-т орсон тул commit
# хийгдэхгүй.
#
# Уншигдах газар:
#   • `server.js`         — локал dev-т доорх .env loader-оор автоматаар татна
#   • `api/*.js`          — Vercel деплой дээр Project Settings → Environment
#                           Variables цонхон дахь утгыг ашиглана
# -----------------------------------------------------------------------------

# ── YouTube Data API v3 ─────────────────────────────────────────────────────
# Дуу хайх функцийн серверийн прокси (/api/youtube-search) үүнд түшдэг.
# Тохируулаагүй үед create.html дээрх YouTube search 503 буцаана — Tone.js
# fallback мелодиор ажиллана.
#
# Хэрхэн авах:
#   1. https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   2. "Enable" YouTube Data API v3
#   3. Credentials → Create Credentials → API key
#   4. (санамж) Application restrictions: HTTP referrers → *.vercel.app,
#      localhost:8080; API restrictions: YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
# GOOGLE_API_KEY-г бас хүлээн авдаг (YOUTUBE_API_KEY урьтамжлана):
# GOOGLE_API_KEY=

# ── Supabase (backend хадгалалт, RLS, RPC) ──────────────────────────────────
# api/*.js (Vercel) болон server.js (local) хоёулаа Supabase-руу шууд хандна.
# URL — Project Settings → API → Project URL.
# Service role key — Project Settings → API → service_role secret.
#   ⚠ Service role RLS-ийг тойрдог тул зөвхөн сервер орчинд байх ёстой.
#     Frontend (assets/config.js) дотор anon key л байх ёстой.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Wire QPay эрхийн код борлуулалт ─────────────────────────────────────────
# Хоосон үлдээвэл `server.js` mock горим руу орж жинхэнэ QPay-руу хандахгүй.
# Vercel (prod) дээр WIRE_API_KEY заавал бөглөх — эс бол /api/checkout 503.
WIRE_API_BASE=https://api.wire.mn
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=

# QPay нэхэмжлэлд харагдах тайлбар (80-с илүү тэмдэгт таслагдана)
PAYMENT_DESCRIPTION=Bolzoo invite access

# Урилгын код 1-ийн үнэ (MNT). Frontend price-тай зөрөх ёсгүй.
PRICE_MNT=9900

# Mock (жинхэнэ QPay ашиглахгүй) төлбөр туршилтад зөвшөөрөх уу.
# Зөвхөн локал dev-т `1` болгоно. Production дээр ХЭЗЭЭ Ч `1` тавьж болохгүй —
# эс бол хэн ч /api/dev-mark-paid дуудаж үнэ төлөөгүй код авах эрсдэлтэй.
ALLOW_MOCK_PAYMENT=0

# ── Resend имэйл (RSVP хариу мэдэгдэх) ──────────────────────────────────────
# Урилга эзэмшигчид зочны хариу ирэхэд имэйлээр мэдэгдэхэд ашиглана.
# API key — https://resend.com/api-keys
# MAIL_FROM-ийн domain-ыг Resend Dashboard → Domains дээр verify хийсэн байх
# ёстой. Verify хийгээгүй бол Resend 403 буцаана.
RESEND_API_KEY=
MAIL_FROM=Bolzoo <notify@your-verified-domain>
# RESEND_ENDPOINT=https://api.resend.com/emails   # (default, солих шаардлагагүй)

# ── Локал dev серверийн порт/хост ───────────────────────────────────────────
PORT=8080
HOST=127.0.0.1

# ── Admin dashboard-ын нууц үг ──────────────────────────────────────────────
# ⚠ Зөвхөн `server.js` (local dev) дээр л ашиглагдана. Vercel prod дээр admin
# нэвтрэлт нь Supabase-ийн `admin_settings.admin_password` (bcrypt hash) руу
# явдаг тул энэ env-ийг Vercel-д тавих шаардлагагүй.
# Local default: "admin123". Local дээрээ ч гэсэн өөрчилж болно.
ADMIN_PASSWORD=admin123
